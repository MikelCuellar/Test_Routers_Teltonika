# Configuración de Conexión Teltonika RutOS
TELTONIKA_HOST=192.168.1.1
TELTONIKA_PORT=443
TELTONIKA_USE_HTTPS=true
TELTONIKA_VERIFY_SSL=false
TELTONIKA_USERNAME=admin
TELTONIKA_PASSWORD=admin01

# Parámetros API RutOS
# En RutOS modernos (v7+), se puede generar un API Token estático en System > Administration > API
TELTONIKA_API_TOKEN=

# Configuración Modbus TCP (Puerto por defecto 502)
MODBUS_TCP_HOST=192.168.1.1
MODBUS_TCP_PORT=502
MODBUS_SLAVE_ID=1

# Broker MQTT para pruebas de telemetría (Data to Server)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=teltonika/telemetry
MQTT_USERNAME=
MQTT_PASSWORD=
